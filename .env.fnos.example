# 复制为 .env 后，与 docker-compose.fnos.yml 放在同一个目录。

FEEDDOCK_TAG=latest
FEEDDOCK_PORT=7789
TZ=Asia/Shanghai

# 飞牛 OS 中用于访问挂载目录的用户和组。
# 不确定时先保持 1000；若 data 目录权限不足，再通过 SSH 执行 id 用户名确认。
PUID=1000
PGID=1000
UMASK=022

# 首次登录：admin / 下方密码。首次登录后必须修改。
ADMIN_USER=admin
ADMIN_PASSWORD=请修改为首次登录密码
SESSION_DAYS=7
COOKIE_SECURE=false

POLL_INTERVAL_MINUTES=10
REQUEST_TIMEOUT_SECONDS=20

# 场景 A：qBittorrent 在同一台飞牛 OS，WebUI 映射到宿主机 8080 端口
QBIT_URL=http://host.docker.internal:8080

# 场景 B：qBittorrent 在局域网其他设备
# QBIT_URL=http://192.168.1.20:8080

QBIT_USERNAME=admin
QBIT_PASSWORD=请填写qBittorrent的WebUI密码
QBIT_CATEGORY=rss

# 这是 qBittorrent 所在环境看到的路径，不是 FeedDock 容器的路径。
DOWNLOAD_PATH=/downloads/rss

# 网页一键更新令牌，建议至少 32 个随机字符；两个服务会使用同一个值。
WATCHTOWER_TOKEN=请替换为至少32位随机字符串
