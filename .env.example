# 默认使用 GitHub Actions 发布的预构建镜像；本地开发可改为自行构建的标签
FEEDDOCK_IMAGE=ghcr.io/planeteditorx/feeddock:latest

# Web 管理界面
APP_PORT=7789
APP_NAME=FeedDock
FEEDDOCK_BUILD_VERSION=1.17.13
ADMIN_USER=admin
# 仅作为首次登录密码；首次成功登录后系统会强制修改并保存到 data/feeddock.db
ADMIN_PASSWORD=change-this-to-a-strong-password
SESSION_DAYS=7
# 通过 HTTPS 访问时设为 true
COOKIE_SECURE=false
# 允许网页触发进程重启/关闭；默认 false 更安全
FEEDDOCK_ALLOW_SYSTEM_ACTIONS=false
TZ=Asia/Shanghai

# RSS 调度
POLL_INTERVAL_MINUTES=30
REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
RSS_USER_AGENT=FeedDock/1.17.13 (+self-hosted RSS automation)

MIKAN_BASE_URL=https://mikanime.tv
MIKAN_FALLBACK_URLS=https://mikanani.me,https://mikanani.kas.pub
# 已浏览季度每隔多少小时由后台刷新一次；页面默认只读缓存
MIKAN_CACHE_HOURS=6
# 浏览器封面缓存时间；服务端本地文件始终优先使用
MIKAN_IMAGE_CACHE_DAYS=30
# Mikan 目录卡片使用的小尺寸 WebP 缩略图

MIKAN_THUMBNAIL_WIDTH=240
MIKAN_THUMBNAIL_HEIGHT=320

# 非 Mikan 番剧周历镜像，按顺序尝试；全部失败时自动回退到 Mikan 季度目录

# qBittorrent Web API
# 使用外部 qBittorrent 时直接填写局域网或公网 HTTPS 地址，不需要启动 with-qbit profile
QBIT_URL=http://192.168.1.20:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=替换为qBittorrent密码
QBIT_CATEGORY=rss

# FeedDock 发给 qBittorrent 的路径，必须是 qBittorrent 所在主机/容器可识别的路径
# 可以是 /vol2/1000/影视；与下方 MEDIA_LOCAL_ROOT 不必相同
DOWNLOAD_PATH=/media

# 在线版本检查优先读取静态 update.json，不消耗 GitHub REST API 限额。
# 发布新版本时只需同步更新仓库根目录的 update.json。
UPDATE_MANIFEST_URLS=https://cdn.jsdelivr.net/gh/planeteditorx/feeddock@main/update.json,https://raw.githubusercontent.com/planeteditorx/feeddock/main/update.json
UPDATE_CHECK_CACHE_HOURS=6
# 静态清单不可用且没有缓存时，GitHub Release API 仅作为每天最多一次的备用检查。
UPDATE_REPOSITORY=planeteditorx/feeddock
UPDATE_API_URL=https://api.github.com
UPDATE_GITHUB_TOKEN=

# 网页一键更新。WATCHTOWER_TOKEN 与 Watchtower 容器必须一致。
# 生成方式：openssl rand -hex 32
WATCHTOWER_URL=http://watchtower:8080
WATCHTOWER_TOKEN=替换为openssl生成的64位十六进制字符串

# 可选内置 qBittorrent 容器
PUID=0
PGID=0
QBIT_WEBUI_PORT=8080

# 元数据、Emby 规范命名与可选本地刮削
METADATA_LANGUAGE=zh-CN
METADATA_AUTO_SYNC_HOURS=24
TMDB_API_BASE=https://api.themoviedb.org
TMDB_IMAGE_BASE=https://image.tmdb.org
# 可填写 32 位 v3 API Key 或 v4 Read Access Token
TMDB_READ_ACCESS_TOKEN=
BANGUMI_ACCESS_TOKEN=
# FeedDock 容器实际可见的挂载路径；与 DOWNLOAD_PATH 指向同一宿主机目录即可
MEDIA_LOCAL_ROOT=/media
EMBY_URL=
EMBY_API_KEY=

ANILIST_API_URL=https://graphql.anilist.co
TMM_URL=
TMM_API_KEY=
AUTOMATION_TIME=02:00
AUTOMATION_TIMEZONE=Asia/Shanghai
OUTBOUND_PROXY_URL=
OUTBOUND_NO_PROXY=localhost,127.0.0.1,host.docker.internal

# FeedDock 容器使用的外部 DNS。修改后必须执行 docker compose up -d --force-recreate，
# 仅重启应用进程不会更新 /etc/resolv.conf。
FEEDDOCK_DNS_PRIMARY=223.5.5.5
FEEDDOCK_DNS_SECONDARY=119.29.29.29
FEEDDOCK_DNS_TERTIARY=1.1.1.1
